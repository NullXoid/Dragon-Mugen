trigger1 = Time = 0
value = SCA
time = 15
[State 5210, 4]
type = CtrlSet
trigger1 = Time = 20
value = 1
[State 5210, 5]
type = VelAdd;Gravity
trigger1 = Time >= 4
y = .35
[State 5210, 5] ;Land on ground
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMP_LAND
ctrl = 1
