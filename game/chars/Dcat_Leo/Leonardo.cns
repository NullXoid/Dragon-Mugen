trigger1=!numtarget(3200)
trigger2=EnemyNear, stateno=5101
trigger3=EnemyNear, stateno=5100
trigger3=EnemyNear, time>1
trigger4=!numtarget(3000)
trigger5=EnemyNear, stateno=3005
trigger5=EnemyNear, time>1
