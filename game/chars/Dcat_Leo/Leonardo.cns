trigger1=time>=3

[State 101, END]
type = ChangeState
triggerall= time>10
trigger1 = time>10
trigger1 = command!= "holdfwd"
trigger2 = time>12
trigger2 = Command = "holddown"
trigger3 = time>12
trigger3 = Command = "holdback"
trigger4 = anim=101&&time>=10
trigger5 = animtime=0
value=890
ctrl =0

[State -1, Null]
