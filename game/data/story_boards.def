; Dragon story route boards.
; Edit this file to build story flow without recompiling the engine.
;
; Node type values:
;   side_scroller - scrolling beat-em-up board
;   mid_boss      - shorter board with a stronger encounter
;   shop          - route stop that enters the shop hub
;   arena_boss    - boss encounter board
;
; Wave sections use [Board N.Wave M].
;   enemies    = character refs for enemy slots, comma-separated
;   spawn_x    = per-slot X offsets from the wave spawn anchor
;   spawn_z    = per-slot arena-depth offsets
;   reward_xp  = optional reward when the wave clears
;   reward_gold = optional reward when the wave clears
; Board sections can also use board_reward_xp/board_reward_gold,
; clear_cue_image, and shop_cue_image.

[Route]
id = aben_arena_mall_route
title = A.BEN ARENA MALL ROUTE
forward_cue_image = data/story/wave_clear_arrow.png

[Board 0]
